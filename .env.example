# === Supabase ===
# Panel del proyecto en Supabase -> Settings -> API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "service_role" secret. NUNCA la expongas en el cliente. Solo server-side.
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# === Anthropic ===
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# === Panel admin ===
# Inventá una clave que solo sepan Emi y Cami. Se valida en el servidor.
ADMIN_PASSCODE=cambiame-por-algo-secreto
